# Copy to .env next to docker-compose.yml. Every value is optional; the platform runs in demo mode without them.

# --- alert delivery (api/alerts/worker.py). Keep ALERTS_DRY_RUN=1 until a test email and text have arrived.
ALERTS_DRY_RUN=1
APP_URL=http://localhost:8080/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@property-intelligence.internal
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# SMS_WEBHOOK_URL=            # instead of Twilio: any gateway that accepts POST {to, text}

# --- assistant (Claude). Set VITE_ASSISTANT=claude so the web build uses it.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
VITE_ASSISTANT=

# --- logins without single sign-on: email and password accounts managed on Data sources -> Users and sign-in.
# Set VITE_AUTH=local and a secret (openssl rand -hex 32). ADMIN_EMAIL / ADMIN_PASSWORD create the first admin at start-up.
VITE_AUTH=                    # "local" for email and password sign-in; leave blank for the demo personas or single sign-on
LOCAL_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- single sign-on (Microsoft Entra ID or any OpenID Connect provider). Overrides VITE_AUTH=local when set.
VITE_OIDC_AUTHORITY=          # e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
VITE_OIDC_CLIENT_ID=
OIDC_ISSUER=                  # same authority, for the API to verify tokens
OIDC_AUDIENCE=                # the client id or API audience
VITE_ADMIN_EMAILS=            # comma separated, in place of app roles
ADMIN_EMAILS=

# --- Ordnance Survey basemaps (osdatahub.os.uk, free tier). Leave blank to use the free OpenFreeMap basemap.
VITE_OS_API_KEY=

# --- data provider: the FastAPI/PostGIS API at /api (the Vite dev server proxies /api to localhost:8000).
VITE_DATA_PROVIDER=http
